        },
        {
          "name": "GET /avaliacao/rotulos",
          "request": {
            "method": "GET",
            "description": "Lista o conjunto de avaliação: total, quantas relevantes e cada rótulo.",
            "url": "{{match}}/avaliacao/rotulos"
          }
        },
        {
          "name": "POST /avaliacao/executar (sem LLM, grátis)",
          "request": {
            "method": "POST",
            "description": "Roda o funil só sobre as vagas rotuladas e mede a precision@5 do BM25, o recall do BM25 e as relevantes descartadas pelos filtros.",
