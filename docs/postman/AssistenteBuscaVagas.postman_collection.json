        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{coleta}}/health"
          }
        },
        {
          "name": "POST /coletar (Claude + Firecrawl, PAGO)",
          "request": {
            "method": "POST",
            "description": "Roda o agente: o Claude planeja buscas, abre páginas e grava as vagas via salvar_vagas. Gasta tokens da Anthropic e até 26 créditos do Firecrawl por dia. 'pedido' é opcional.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": \"faça a coleta diária, priorizando vagas remotas de .NET\"\n}"
            },
            "url": "{{coleta}}/coletar"
          }
        },
        {
          "name": "POST /coletar/remotive (sem LLM)",
          "request": {
            "method": "POST",
            "description": "Fluxo fixo: só a API da Remotive. Respeita o intervalo mínimo de 6 h entre consultas.",
            "url": "{{coleta}}/coletar/remotive"
          }
        },
        {
          "name": "GET Agent Card",
          "request": {
            "method": "GET",
            "description": "Agent Card (A2A): nome, descrição, URL do endpoint e habilidades. É o que o roteador lê.",
            "url": "{{coleta}}/.well-known/agent-card.json"
          }
        },
        {
          "name": "A2A SendMessage: coletar_remotive",
          "request": {
            "method": "POST",
            "description": "Coleta da Remotive, sem LLM. Envelope do projeto: parte de texto (pedido) + parte de dados {\"habilidade\", \"dados\"}. A resposta vem em result.message.parts: texto (resumo) + dados {\"resultado\"} ou {\"erro\"}.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "A2A-Version",
                "value": "1.0"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"SendMessage\",\n  \"params\": {\n    \"message\": {\n      \"messageId\": \"{{$guid}}\",\n      \"role\": \"ROLE_USER\",\n      \"parts\": [\n        {\n          \"text\": \"busque vagas novas\"\n        },\n        {\n          \"data\": {\n            \"habilidade\": \"coletar_remotive\"\n          }\n        }\n      ]\n    }\n  }\n}"
            },
            "url": "{{coleta}}/a2a"
          }
        }
      ]
    },
